{
  "name": "irumbom-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "lib/seed-ts"
  ],
  "scripts": {
    "dev": "vite",
    "dev:vercel": "npx vercel@latest dev --cwd ..",
    "build": "vite build",
    "build:vercel": "vite build",
    "build:pages": "vite build",
    "typecheck:backend": "tsc -p tsconfig.backend.json --pretty false",
    "test:backend-contracts": "tsx --test test/**/*.test.ts",
    "test:emulator:maintenance": "node test/emulator/run-maintenance-firestore.mjs",
    "test:emulator:sync-maintenance": "npm run test:emulator:maintenance",
    "test:deployment-boundaries": "tsx --test test/backend/deployment-storage-boundary.test.ts test/premium/premium-import-boundary.test.ts",
    "auth:role": "tsx tools/auth-role-provisioning.ts",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "setup:libs": "npm --prefix ../lib/saju-ts ci --omit=dev && npm --prefix ../lib/seed-ts ci --omit=dev && npm --prefix ../lib/spring-ts ci --omit=dev",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tosspayments/tosspayments-sdk": "^2.6.0",
    "fflate": "^0.8.2",
    "firebase-admin": "^14.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "15.24.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0-beta.13"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
