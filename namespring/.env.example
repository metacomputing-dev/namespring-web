# Frontend runtime configuration
VITE_PAYMENT_ENABLED=false
VITE_TOSS_CLIENT_KEY=
# Optional. If unset, frontend calls same-origin /api.
VITE_API_BASE_URL=
# Optional (dev only). If VITE_API_BASE_URL is unset, Vite proxies /api to this target.
# Example: http://localhost:3000
VITE_LOCAL_API_PROXY_TARGET=
# Optional (dev only). Enable only when you specifically need cross-origin isolation for local WASM tooling.
VITE_DEV_ENABLE_CROSS_ORIGIN_ISOLATION=false
# Optional. Override payment app origin.
# If unset in production (non-localhost), defaults to https://namespring-web.vercel.app.
VITE_PAYMENT_APP_ORIGIN=
# Optional. Override canonical redirect origin.
# If unset in production (non-localhost), defaults to https://namespring-web.vercel.app.
VITE_CANONICAL_ORIGIN=

# Server secret separation (fail-closed)
# Generate every server-side secret and every retained keyring entry below
# independently. Never reuse material across provider identity binding, auth audit, role provisioning, rate limiting, sync
# deletion receipts, cron authentication, Toss, content gate/audit, premium
# audit, or premium encryption. The backend rejects byte-for-byte reuse,
# including base64-decoded AES key material, without logging either secret.

# Toss server-side configuration
TOSS_SECRET_KEY=
# Exact official origin only. Test credentials use this same origin; other
# hosts, credentials, paths, queries, and schemes fail before network I/O.
TOSS_API_BASE_URL=https://api.tosspayments.com

# Legacy admin refunds use the Firebase admin role, Origin, CSRF, and rate limit.
# Static ADMIN_REFUND_TOKEN authentication is retired and must not be configured.

# Firebase Admin credentials (choose one approach)
# 1) Single JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=

# 2) Split fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Account/session backend (server only)
# Exact canonical origin, without a path. Add preview origins explicitly below.
PUBLIC_APP_ORIGIN=https://namespring-web.vercel.app
AUTH_ALLOWED_ORIGINS=https://namespring-web.vercel.app
# Enable only providers whose console, redirect, account-linking, and deletion
# flows have passed the staging gates. The intended first set is Google, Kakao
# OIDC, and passwordless email link, but a copied example must not activate
# them. Add `anonymous` only after validating the Firebase anonymous bridge; it
# is required for, and accepted only by, explicit sync/payment session intents.
# Free/local use never calls that bridge or creates a server account. `apple` is
# deliberately rejected until the server can capture/revoke
# Apple credentials and process credential-revoked notifications; an env
# change alone cannot enable it.
AUTH_ENABLED_PROVIDERS=
# Required whenever kakao_oidc is enabled. Copy the exact provider identifier
# configured in Firebase Authentication (for example, oidc.kakao); family or
# substring matching is deliberately forbidden.
AUTH_KAKAO_FIREBASE_PROVIDER_ID=
# Future generic OIDC only: comma-separated exact Firebase provider IDs (1-8).
# Leave empty at launch; enabling `oidc` also requires this allowlist.
AUTH_GENERIC_OIDC_FIREBASE_PROVIDER_IDS=
# Required before the Firestore auth account repository can open. Use
# prelaunch_empty_v1_verified only after proving every documented auth v1
# collection is empty in the target project. Existing data requires a
# frozen-write migration to the exact v1 codec before using
# legacy_v1_migration_verified. Missing/other values fail closed.
AUTH_ACCOUNT_STORAGE_CUTOVER_STATE=
# Provider binding document IDs and stored subjects are keyed, domain-separated
# HMAC v2 values. For a verified empty store use
# prelaunch_empty_hmac_v2_verified. An existing store must freeze auth writes,
# reconstruct exact provider subjects from trusted Firebase/provider evidence,
# rewrite every account/binding/lifecycle reference, and independently verify
# the migration before using legacy_sha256_to_hmac_v2_migration_verified.
# This value must match the account-storage cutover path; missing/mismatched
# values fail before Firestore account access.
AUTH_IDENTITY_BINDING_CUTOVER_STATE=
# Dedicated immutable 32-256 UTF-8 byte server key. Never expose it as VITE_*,
# reuse another domain's key, or rotate it without the same frozen-write
# one-to-one binding migration required above.
AUTH_IDENTITY_BINDING_HMAC_KEY=
AUTH_SESSION_DAYS=5
AUTH_RECENT_AUTH_MAX_AGE_SECONDS=300
AUTH_CSRF_TTL_SECONDS=3600
# Dedicated audit pseudonymization key, at least 32 bytes. It must not equal
# RATE_LIMIT_HMAC_KEY, SYNC_DELETION_HASH_PEPPER, or any premium/content key.
AUTH_AUDIT_HMAC_KEY=
# Trusted role-provisioning receipts and leases use a separate 32-256-byte HMAC
# key. Never reuse it for auth audit, rate limits, sync, payments, content,
# premium, cron, or Firebase credentials. It is server/CLI-only and never VITE_*.
AUTH_ROLE_PROVISIONING_HMAC_KEY=
# Production must remain required. Use a random value of at least 32 bytes.
AUTH_RATE_LIMIT_MODE=required
# Local/test session creation ignores forwarding headers. Set one fixed valid
# address (normally 127.0.0.1) to exercise the pre-authentication IP bucket.
# Production ignores this value and requires Vercel's dedicated
# x-vercel-forwarded-for header (never generic x-forwarded-for).
AUTH_TRUSTED_DEV_CLIENT_IP=127.0.0.1
SYNC_RATE_LIMIT_MODE=required
RATE_LIMIT_HMAC_KEY=

# Vercel Cron authentication (server only). Use an independent random value of
# at least 32 UTF-8 bytes. Vercel sends it as `Authorization: Bearer ...`.
CRON_SECRET=

# Trusted content pipeline. A bounded JSON object with 1-8 key IDs and distinct
# 32-256-byte secrets, e.g. {"content-ci-2026-07":"<random secret>"}.
# A passed general or premium gate cannot be registered/reviewed without a
# matching CI HMAC attestation. Premium uses a separate protocol/domain string.
CONTENT_GATE_ATTESTATION_KEYRING_JSON=
# Bounded content actor/audit pseudonym keyring. Keep old keys until every
# referencing artifact is explicitly migrated; premature removal freezes
# content mutations. Each secret is 32-256 bytes and dedicated to this domain.
# Example: {"currentKeyId":"2026-07","keys":{"2026-06":"<old random secret>","2026-07":"<current random secret>"}}
CONTENT_AUDIT_HMAC_KEYRING_JSON=
# Full-catalog local export remains fail-closed above 2,500 active artifacts.
# Enable only after the project-wide Pro cron gate, selected Fluid Compute
# operating model, explicit 300-second function boundary, Firestore indexes/TTL,
# budget alerts, and the content export runbook have been checked and timed.
# The explicit ceiling must be 2,501-25,000 and should narrowly cover the
# reviewed corpus (the current development mock corpus needs at least 21,060).
CONTENT_EXPORT_OPERATIONAL_STATE=
CONTENT_EXPORT_MAX_ACTIVE_ARTIFACTS=

# Paid report backend (server only)
# Exact launch attestation. Use prelaunch_empty_v1_verified only after proving
# no v1 owner/index data exists; otherwise complete the documented migration
# and use legacy_v1_migration_verified. Missing/other values fail closed.
PREMIUM_OWNER_V2_CUTOVER_STATE=
# Dedicated audit HMAC keyring. Keep every referenced key for the full 365-day
# audit window. Keys are 32-256 random bytes and must not be reused by auth,
# rate-limit, sync, Toss, content, premium encryption, or any other domain.
# Example: {"currentKeyId":"2026-07","keys":{"2026-06":"<old random secret>","2026-07":"<current random secret>"}}
PREMIUM_AUDIT_HMAC_KEYRING_JSON=
# Independent random values. Never expose any server value as VITE_*.
SYNC_DELETION_HASH_PEPPER=
# Example shape: {"currentKeyId":"2026-07","keys":{"2026-07":"<base64 32-byte key>"}}
PREMIUM_ANALYSIS_ENCRYPTION_KEYS_JSON=
# Optional override. The checked-in catalog is deliberately unavailable.
# An active override is accepted only with the exact activation fence below.
PREMIUM_SERVICE_CATALOG_JSON=
PREMIUM_CATALOG_ACTIVATION_STATE=
# Toss web checkout is separately disabled until staging verification is attested.
PREMIUM_TOSS_WEB_RAIL_STATE=
# Current policy versions/digests. Registration and checkout fail closed when
# absent or stale; do not put notice/terms body text or personal data here.
# Shape: {"schemaVersion":"namespring.premium-policy-contract.v1","dataProcessing":{"noticeVersion":"...","noticeDigest":"sha256:<64 hex>","purpose":"premium_report_server_recomputation"},"purchase":{"termsVersion":"...","termsDigest":"sha256:<64 hex>","refundPolicyVersion":"...","refundPolicyDigest":"sha256:<64 hex>"}}
PREMIUM_POLICY_CONTRACT_JSON=
# Required before premium admin metadata discovery. Use prelaunch_empty only
# after proving all source/projection collections are empty; otherwise backfill
# and verify exact parity first.
PREMIUM_ADMIN_DISCOVERY_CUTOVER_STATE=

# Optional paid-server filesystem overrides. Defaults are immutable repo assets.
NAMESPRING_ENGINE_HANJA_DB_FILE=
NAMESPRING_ENGINE_FOURFRAME_DB_FILE=
NAMESPRING_ENGINE_SQL_WASM_FILE=
NAMESPRING_ENGINE_NAME_STAT_FILE=
