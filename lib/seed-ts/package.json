{
  "name": "@namespring/seed-ts",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run check:fourframe-catalog && npm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p test/tsconfig.json --pretty false",
    "test:sync-contract": "tsx test/seed-sync-contract.test.ts",
    "generate:fourframe-catalog": "tsx tools/generate-fourframe-catalog.ts --write",
    "check:fourframe-catalog": "tsx tools/generate-fourframe-catalog.ts --check",
    "test:fourframe-catalog": "npm run check:fourframe-catalog && tsx test/fourframe-catalog-parity.test.ts",
    "test:repository-lifecycle": "tsx test/repository-lifecycle.test.ts",
    "test:contracts": "npm run typecheck && npm run typecheck:test && npm run test:sync-contract && npm run test:fourframe-catalog && npm run test:repository-lifecycle",
    "test": "npm run test:contracts && npm run test:package-contract",
    "test:package-contract": "node --test --experimental-test-isolation=none test/package-contract.test.mjs"
  },
  "dependencies": {
    "sql.js": "1.14.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/sql.js": "^1.4.9",
    "sqlite3": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
