{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://namespring.local/spring-ts/panelAdjudicationManifest.schema.json",
  "title": "spring-ts Panel Adjudication Manifest",
  "$defs": {
    "approvedModelIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "family", "version"],
          "properties": {
            "provider": { "const": "anthropic" },
            "family": { "const": "claude" },
            "version": { "const": "5" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "family", "version"],
          "properties": {
            "provider": { "const": "openai" },
            "family": { "const": "gpt" },
            "version": { "const": "5" }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": {
      "const": "spring-ts.panel-adjudication.v1"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordId",
          "contentDigest",
          "models",
          "scopes",
          "adversarialVerification",
          "verdict",
          "reviewedBy",
          "reviewedAt",
          "evidence"
        ],
        "properties": {
          "recordId": {
            "type": "string",
            "minLength": 1
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "models": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/approvedModelIdentity" }
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "const": "saju_doctrine" }
          },
          "adversarialVerification": {
            "const": true
          },
          "verdict": {
            "const": "approved"
          },
          "reviewedBy": {
            "type": "string",
            "minLength": 1,
            "description": "Self-attested accountability metadata; not reviewer authentication or external expert certification."
          },
          "reviewedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "path", "bytes", "fileDigest"],
              "properties": {
                "model": {
                  "$ref": "#/$defs/approvedModelIdentity"
                },
                "path": { "type": "string", "minLength": 1 },
                "bytes": { "type": "integer", "minimum": 64 },
                "fileDigest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
