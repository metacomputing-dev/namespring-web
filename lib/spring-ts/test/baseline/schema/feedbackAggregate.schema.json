{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://namespring.local/spring-ts/feedbackAggregate.schema.json",
  "title": "spring-ts Privacy Preserving Feedback Aggregate",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "artifactKind",
    "authorityUsage",
    "generatedAt",
    "window",
    "privacy",
    "retention",
    "totals",
    "cardFeedback",
    "candidateNameRejections"
  ],
  "properties": {
    "schemaVersion": {
      "const": "spring-ts.feedback-aggregate.v1"
    },
    "artifactKind": {
      "const": "privacy_preserving_aggregate_feedback"
    },
    "authorityUsage": {
      "const": "not_authority_truth"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startDate",
        "endDate",
        "timezone"
      ],
      "properties": {
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceFree",
        "aggregateOnly",
        "rawFeedbackStoredInRepo",
        "minBucketCount",
        "prohibitedFields"
      ],
      "properties": {
        "sourceFree": {
          "const": true
        },
        "aggregateOnly": {
          "const": true
        },
        "rawFeedbackStoredInRepo": {
          "const": false
        },
        "minBucketCount": {
          "type": "integer",
          "minimum": 10
        },
        "prohibitedFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawFeedbackRetentionDays",
        "aggregateRetentionDays"
      ],
      "properties": {
        "rawFeedbackRetentionDays": {
          "const": 0
        },
        "aggregateRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 730
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "cardFeedback",
        "candidateNameRejections"
      ],
      "properties": {
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "cardFeedback": {
          "type": "integer",
          "minimum": 0
        },
        "candidateNameRejections": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cardFeedback": {
      "type": "object"
    },
    "candidateNameRejections": {
      "type": "object"
    }
  }
}
