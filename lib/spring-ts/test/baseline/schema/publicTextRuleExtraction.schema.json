{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://namespring.local/spring-ts/publicTextRuleExtraction.schema.json",
  "title": "spring-ts Public Text Rule Extraction Fixtures",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "collectionId",
    "accessedAt",
    "sourceRegistry",
    "vocabularyDictionary",
    "sourceTier",
    "usagePolicy",
    "snippets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "spring-ts.public-text-rule-extraction.v1"
    },
    "collectionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "accessedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceRegistry": {
      "const": "data/sources/classical-myeongri.sources.json"
    },
    "vocabularyDictionary": {
      "const": "data/classical-vocabulary/classical-myeongri-vocabulary.json"
    },
    "sourceTier": {
      "$ref": "sourceTier.schema.json"
    },
    "usagePolicy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "noBulkCopy",
        "maxQuoteChars",
        "allowed",
        "prohibited"
      ],
      "properties": {
        "noBulkCopy": {
          "const": true
        },
        "maxQuoteChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "prohibited": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "snippets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "group",
          "sourceId",
          "sourceLocator",
          "quoteShort",
          "feature",
          "linkedVocabularyTermIds",
          "ruleEvidenceEligible",
          "humanInterpretation",
          "sourceTier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "group": {
            "enum": [
              "stemTransparency",
              "seasonalCommand",
              "specialFrame",
              "usefulGodConflict"
            ]
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "sourceLocator": {
            "type": "string",
            "minLength": 1
          },
          "quoteShort": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "feature": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface",
              "fieldPath",
              "code",
              "scoreKey",
              "engineRef"
            ],
            "properties": {
              "surface": {
                "type": "string",
                "minLength": 1
              },
              "fieldPath": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "scoreKey": {
                "type": ["string", "null"]
              },
              "engineRef": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "linkedVocabularyTermIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "ruleEvidenceEligible": {
            "const": true
          },
          "humanInterpretation": {
            "type": "string",
            "minLength": 1
          },
          "sourceTier": {
            "$ref": "sourceTier.schema.json"
          }
        }
      }
    }
  }
}
