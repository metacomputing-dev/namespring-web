{
  "name": "spring-ts",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:env": "npx tsx test/integration/saju-ts-load.test.ts",
    "test:saju-disabled": "npx tsx test/integration/saju-calculator-disabled.test.ts",
    "test:presets": "npx tsx test/integration/school-presets.test.ts",
    "test:scoring": "npx tsx test/integration/scoring-opt-in.test.ts",
    "test:jie": "npx tsx test/integration/jie-boundary.test.ts",
    "test:adaptive": "npx tsx test/integration/adaptive-evaluator.test.ts",
    "test:narrative": "npx tsx test/integration/narrative-foundations.test.ts",
    "test:integration": "npm run test:env && npm run test:saju-disabled && npm run test:presets && npm run test:scoring && npm run test:jie && npm run test:adaptive && npm run test:narrative",
    "test:golden": "npx tsx test/compare-output.ts",
    "test:region": "npx tsx test/verify-region-coordinate-resolution.ts",
    "test:snapshot": "npx tsx tools/baseline_snapshot.ts verify",
    "snapshot:capture": "npx tsx tools/baseline_snapshot.ts capture",
    "validate:regression": "node tools/measure_regression.mjs --baseline main --branch HEAD"
  },
  "dependencies": {
    "sql.js": "^1.14.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/sql.js": "^1.4.9",
    "typescript": "^5.9.3"
  }
}
